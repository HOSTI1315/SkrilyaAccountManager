<Window x:Class="RamPreview.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SkrilyaAccountManager" Height="740" Width="1180"
        WindowStartupLocation="CenterScreen" Topmost="True"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FontFamily="{StaticResource UiFont}" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

  <Border CornerRadius="14" Background="{StaticResource BgWave}" BorderBrush="{StaticResource Stroke}" BorderThickness="1">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="218"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- ================= left rail ================= -->
      <Border Grid.Column="0" Background="{StaticResource RailWave}" CornerRadius="14,0,0,14">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <!-- brand -->
          <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="22,22,0,10">
            <Border Width="26" Height="26" CornerRadius="8" Background="#FF0E1A20" BorderBrush="#552DE2E6" BorderThickness="1">
              <TextBlock Text="R" Foreground="{StaticResource Accent}" FontWeight="Bold" FontSize="13"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
              <Border.Effect><DropShadowEffect Color="#2DE2E6" BlurRadius="16" ShadowDepth="0" Opacity="0.5"/></Border.Effect>
            </Border>
            <TextBlock Text="SKRILYA" Foreground="{StaticResource Text}" FontWeight="Bold" FontSize="13.5"
                       VerticalAlignment="Center" Margin="10,0,0,0" FontFamily="{StaticResource MonoFont}"/>
          </StackPanel>

          <StackPanel Grid.Row="1">
            <TextBlock Text="MAIN" Style="{StaticResource RailSection}"/>
            <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Content="◈   Dashboard"/>
            <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Content="◉   Accounts" IsChecked="True"/>

            <TextBlock Text="LAUNCH" Style="{StaticResource RailSection}"/>
            <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Content="▲   Launcher"/>
            <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Content="↻   Relauncher"/>
            <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Content="◎   Watcher"/>

            <TextBlock Text="TOOLS" Style="{StaticResource RailSection}"/>
            <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Content="✦   Free items"/>
            <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Content="▶   Macros"/>
            <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Content="⌗   Server list"/>

            <TextBlock Text="SYSTEM" Style="{StaticResource RailSection}"/>
            <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Content="⛨   Proxies"/>
            <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Content="▤   Resources"/>
          </StackPanel>

          <StackPanel Grid.Row="2" Margin="0,0,0,16">
            <Border Height="1" Background="{StaticResource StrokeSoft}" Margin="18,0,18,12"/>
            <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Content="⚙   Settings"/>
          </StackPanel>
        </Grid>
      </Border>

      <!-- ================= content ================= -->
      <Grid Grid.Column="1" Margin="0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- header: search + window buttons -->
        <Grid Grid.Row="0" Margin="24,18,20,6">
          <Border CornerRadius="18" Background="#FF0C1016" BorderBrush="{StaticResource Stroke}" BorderThickness="1"
                  HorizontalAlignment="Center" Width="430" Height="36">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
              <TextBlock Text="⌕" Foreground="{StaticResource TextFaint}" FontSize="14" VerticalAlignment="Center"/>
              <TextBlock Text="Search anything — accounts, actions, settings…" Foreground="{StaticResource TextFaint}"
                         FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0"/>
            </StackPanel>
          </Border>

          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <TextBlock Text="—" Foreground="{StaticResource TextMuted}" Margin="10,0" FontSize="13"/>
            <TextBlock Text="▢" Foreground="{StaticResource TextMuted}" Margin="10,0" FontSize="12"/>
            <TextBlock Text="✕" Foreground="{StaticResource TextMuted}" Margin="10,0,4,0" FontSize="12"/>
          </StackPanel>
        </Grid>

        <!-- pill tabs -->
        <Border Grid.Row="1" CornerRadius="20" Background="#FF0B0F15" BorderBrush="{StaticResource StrokeSoft}"
                BorderThickness="1" HorizontalAlignment="Left" Margin="24,6,0,10" Padding="4">
          <StackPanel Orientation="Horizontal">
            <RadioButton Style="{StaticResource PillTab}" GroupName="tabs" Content="Accounts" IsChecked="True"/>
            <RadioButton Style="{StaticResource PillTab}" GroupName="tabs" Content="Launcher"/>
            <RadioButton Style="{StaticResource PillTab}" GroupName="tabs" Content="Watcher"/>
          </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="24,4,20,20">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <!-- title card -->
          <Border Grid.Row="0" CornerRadius="14" Background="{StaticResource CardWave}" BorderBrush="{StaticResource StrokeSoft}"
                  BorderThickness="1" Padding="22,18">
            <Grid>
              <StackPanel>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="Accounts" Foreground="{StaticResource Text}" FontSize="21" FontWeight="Bold"/>
                  <Border CornerRadius="10" Background="{StaticResource AccentDim}" Padding="8,2" Margin="12,4,0,0"
                          BorderBrush="#442DE2E6" BorderThickness="1" VerticalAlignment="Center">
                    <TextBlock Text="3 / 3 valid" Foreground="{StaticResource Accent}" FontSize="10.5" FontFamily="{StaticResource MonoFont}"/>
                  </Border>
                </StackPanel>
                <TextBlock Text="Manage, filter and launch your accounts" Foreground="{StaticResource TextMuted}"
                           FontSize="12" Margin="0,4,0,0"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Style="{StaticResource GhostButton}" Content="↻   Refresh" Margin="0,0,10,0"/>
                <Button Style="{StaticResource AccentButton}" Content="+   Add account"/>
              </StackPanel>
            </Grid>
          </Border>

          <!-- filters -->
          <Border Grid.Row="1" CornerRadius="14" Background="{StaticResource Card}" BorderBrush="{StaticResource StrokeSoft}"
                  BorderThickness="1" Padding="14,10" Margin="0,12,0,0">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Border Grid.Column="0" CornerRadius="10" Background="#FF0C1016" BorderBrush="{StaticResource Stroke}"
                      BorderThickness="1" Height="32" HorizontalAlignment="Left" Width="260">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                  <TextBlock Text="⌕" Foreground="{StaticResource TextFaint}" FontSize="13"/>
                  <TextBlock Text="Search accounts…" Foreground="{StaticResource TextFaint}" FontSize="12" Margin="8,0,0,0"/>
                </StackPanel>
              </Border>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton Style="{StaticResource Chip}" GroupName="filter" Content="All" IsChecked="True"/>
                <RadioButton Style="{StaticResource Chip}" GroupName="filter" Content="Valid"/>
                <RadioButton Style="{StaticResource Chip}" GroupName="filter" Content="Invalid"/>
                <RadioButton Style="{StaticResource Chip}" GroupName="filter" Content="Banned"/>
                <Border Width="1" Height="18" Background="{StaticResource Stroke}" Margin="10,0"/>
                <TextBlock Text="Default" Foreground="{StaticResource TextMuted}" FontSize="11.5" VerticalAlignment="Center" Margin="4,0,8,0"/>
              </StackPanel>
            </Grid>
          </Border>

          <!-- list + launcher -->
          <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="330"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" CornerRadius="14" Background="{StaticResource Card}" BorderBrush="{StaticResource StrokeSoft}"
                    BorderThickness="1" Padding="14,14" Margin="0,0,12,0">
              <StackPanel>
                <TextBlock Text="ACCOUNTS" Foreground="{StaticResource TextFaint}" FontSize="10"
                           FontFamily="{StaticResource MonoFont}" Margin="6,0,0,10"/>

                <!-- row 1: selected, accent edge + glow -->
                <Border CornerRadius="12" Background="{StaticResource CardRaised}" BorderBrush="#442DE2E6" BorderThickness="1"
                        Padding="12,10" Margin="0,0,0,8">
                  <Border.Effect><DropShadowEffect Color="#2DE2E6" BlurRadius="22" ShadowDepth="0" Opacity="0.18"/></Border.Effect>
                  <Grid>
                    <StackPanel Orientation="Horizontal">
                      <Border Width="34" Height="34" CornerRadius="10" Background="#FF16202B" BorderBrush="#332DE2E6" BorderThickness="1">
                        <TextBlock Text="0" Foreground="{StaticResource Accent}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Border>
                      <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="0c_PF" Foreground="{StaticResource Text}" FontSize="13" FontWeight="SemiBold"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                          <TextBlock Text="Offline" Foreground="{StaticResource TextFaint}" FontSize="10.5"/>
                          <TextBlock Text="·" Foreground="{StaticResource TextFaint}" FontSize="10.5" Margin="6,0"/>
                          <TextBlock Text="10691258562" Foreground="{StaticResource TextFaint}" FontSize="10.5" FontFamily="{StaticResource MonoFont}"/>
                        </StackPanel>
                      </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                      <TextBlock Text="R$ 0" Foreground="{StaticResource TextMuted}" FontSize="11.5" Margin="0,0,14,0" FontFamily="{StaticResource MonoFont}"/>
                      <Ellipse Width="7" Height="7" Fill="{StaticResource Good}" VerticalAlignment="Center">
                        <Ellipse.Effect><DropShadowEffect Color="#3DDC97" BlurRadius="10" ShadowDepth="0" Opacity="0.9"/></Ellipse.Effect>
                      </Ellipse>
                      <TextBlock Text="Valid" Foreground="{StaticResource Good}" FontSize="11.5" Margin="7,0,4,0"/>
                    </StackPanel>
                  </Grid>
                </Border>

                <!-- row 2 -->
                <Border CornerRadius="12" Background="#FF0E131A" BorderBrush="{StaticResource StrokeSoft}" BorderThickness="1"
                        Padding="12,10" Margin="0,0,0,8">
                  <Grid>
                    <StackPanel Orientation="Horizontal">
                      <Border Width="34" Height="34" CornerRadius="10" Background="#FF141A22" BorderBrush="{StaticResource Stroke}" BorderThickness="1">
                        <TextBlock Text="z" Foreground="{StaticResource TextMuted}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Border>
                      <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="z6V4q" Foreground="{StaticResource Text}" FontSize="13" FontWeight="SemiBold"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                          <TextBlock Text="In game" Foreground="{StaticResource Accent}" FontSize="10.5"/>
                          <TextBlock Text="·" Foreground="{StaticResource TextFaint}" FontSize="10.5" Margin="6,0"/>
                          <TextBlock Text="10691244316" Foreground="{StaticResource TextFaint}" FontSize="10.5" FontFamily="{StaticResource MonoFont}"/>
                        </StackPanel>
                      </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                      <Border CornerRadius="8" Background="#1AFF3D8A" BorderBrush="#33FF3D8A" BorderThickness="1" Padding="7,2" Margin="0,0,12,0">
                        <TextBlock Text="proxy · fi-1" Foreground="{StaticResource Magenta}" FontSize="10" FontFamily="{StaticResource MonoFont}"/>
                      </Border>
                      <TextBlock Text="R$ 0" Foreground="{StaticResource TextMuted}" FontSize="11.5" Margin="0,0,14,0" FontFamily="{StaticResource MonoFont}"/>
                      <Ellipse Width="7" Height="7" Fill="{StaticResource Good}" VerticalAlignment="Center">
                        <Ellipse.Effect><DropShadowEffect Color="#3DDC97" BlurRadius="10" ShadowDepth="0" Opacity="0.9"/></Ellipse.Effect>
                      </Ellipse>
                      <TextBlock Text="Valid" Foreground="{StaticResource Good}" FontSize="11.5" Margin="7,0,4,0"/>
                    </StackPanel>
                  </Grid>
                </Border>

                <!-- row 3 -->
                <Border CornerRadius="12" Background="#FF0E131A" BorderBrush="{StaticResource StrokeSoft}" BorderThickness="1" Padding="12,10">
                  <Grid>
                    <StackPanel Orientation="Horizontal">
                      <Border Width="34" Height="34" CornerRadius="10" Background="#FF141A22" BorderBrush="{StaticResource Stroke}" BorderThickness="1">
                        <TextBlock Text="M" Foreground="{StaticResource TextMuted}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Border>
                      <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Matheus748725" Foreground="{StaticResource Text}" FontSize="13" FontWeight="SemiBold"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                          <TextBlock Text="Offline" Foreground="{StaticResource TextFaint}" FontSize="10.5"/>
                          <TextBlock Text="·" Foreground="{StaticResource TextFaint}" FontSize="10.5" Margin="6,0"/>
                          <TextBlock Text="7712240125" Foreground="{StaticResource TextFaint}" FontSize="10.5" FontFamily="{StaticResource MonoFont}"/>
                        </StackPanel>
                      </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                      <TextBlock Text="R$ —" Foreground="{StaticResource TextMuted}" FontSize="11.5" Margin="0,0,14,0" FontFamily="{StaticResource MonoFont}"/>
                      <Ellipse Width="7" Height="7" Fill="{StaticResource Bad}" VerticalAlignment="Center">
                        <Ellipse.Effect><DropShadowEffect Color="#FF5C7A" BlurRadius="10" ShadowDepth="0" Opacity="0.8"/></Ellipse.Effect>
                      </Ellipse>
                      <TextBlock Text="Expired" Foreground="{StaticResource Bad}" FontSize="11.5" Margin="7,0,4,0"/>
                    </StackPanel>
                  </Grid>
                </Border>
              </StackPanel>
            </Border>

            <!-- launcher panel -->
            <Border Grid.Column="1" CornerRadius="14" Background="{StaticResource PanelWave}" BorderBrush="{StaticResource StrokeSoft}"
                    BorderThickness="1" Padding="16,14">
              <StackPanel>
                <TextBlock Text="LAUNCHER" Foreground="{StaticResource TextFaint}" FontSize="10" FontFamily="{StaticResource MonoFont}"/>

                <TextBlock Text="PLACE ID" Foreground="{StaticResource TextFaint}" FontSize="9.5" Margin="0,14,0,6" FontFamily="{StaticResource MonoFont}"/>
                <TextBox Style="{StaticResource Field}" Text="77747658251236"/>

                <Border CornerRadius="12" Background="#FF0C1016" BorderBrush="{StaticResource Stroke}" BorderThickness="1"
                        Margin="0,12,0,0" Padding="12">
                  <StackPanel>
                    <StackPanel Orientation="Horizontal">
                      <Border Width="38" Height="38" CornerRadius="9">
                        <Border.Background>
                          <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FF1B3A5B" Offset="0"/>
                            <GradientStop Color="#FF0E2036" Offset="1"/>
                          </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="⛵" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Border>
                      <TextBlock Text="[2X⚔] Sailor Piece" Foreground="{StaticResource Text}" FontSize="12.5"
                                 FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>
                    <Grid Margin="0,12,0,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <StackPanel Grid.Column="0">
                        <TextBlock Text="ONLINE" Foreground="{StaticResource TextFaint}" FontSize="8.5" FontFamily="{StaticResource MonoFont}"/>
                        <TextBlock Text="5.8K" Foreground="{StaticResource Accent}" FontSize="14" FontWeight="Bold"/>
                      </StackPanel>
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="FAVORITES" Foreground="{StaticResource TextFaint}" FontSize="8.5" FontFamily="{StaticResource MonoFont}"/>
                        <TextBlock Text="828.9K" Foreground="{StaticResource Text}" FontSize="14" FontWeight="Bold"/>
                      </StackPanel>
                      <StackPanel Grid.Column="2">
                        <TextBlock Text="LIKES" Foreground="{StaticResource TextFaint}" FontSize="8.5" FontFamily="{StaticResource MonoFont}"/>
                        <TextBlock Text="1.2M" Foreground="{StaticResource Text}" FontSize="14" FontWeight="Bold"/>
                      </StackPanel>
                    </Grid>
                  </StackPanel>
                </Border>

                <TextBlock Text="JOB ID (OPTIONAL)" Foreground="{StaticResource TextFaint}" FontSize="9.5" Margin="0,14,0,6" FontFamily="{StaticResource MonoFont}"/>
                <TextBox Style="{StaticResource Field}" Text=""/>

                <TextBlock Text="VIP LINK / CODE (OPTIONAL)" Foreground="{StaticResource TextFaint}" FontSize="9.5" Margin="0,12,0,6" FontFamily="{StaticResource MonoFont}"/>
                <TextBox Style="{StaticResource Field}" Text=""/>

                <Button Style="{StaticResource AccentButton}" Content="▶   JOIN SERVER" Margin="0,16,0,0" HorizontalAlignment="Stretch"/>
              </StackPanel>
            </Border>
          </Grid>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>
