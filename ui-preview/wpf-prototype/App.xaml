<Application xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>

    <!-- ============ design tokens: dark base, one neon accent, magenta only as a signal ============ -->
    <Color x:Key="BgColor">#FF07090D</Color>
    <SolidColorBrush x:Key="Bg" Color="{StaticResource BgColor}"/>
    <SolidColorBrush x:Key="BgRail" Color="#FF0A0D12"/>
    <SolidColorBrush x:Key="Card" Color="#FF10141B"/>
    <SolidColorBrush x:Key="CardRaised" Color="#FF141922"/>
    <SolidColorBrush x:Key="Stroke" Color="#FF1D2431"/>
    <SolidColorBrush x:Key="StrokeSoft" Color="#FF161B24"/>
    <SolidColorBrush x:Key="Text" Color="#FFE8EDF5"/>
    <SolidColorBrush x:Key="TextMuted" Color="#FF7B8798"/>
    <SolidColorBrush x:Key="TextFaint" Color="#FF4E5766"/>
    <SolidColorBrush x:Key="Accent" Color="#FF2DE2E6"/>
    <SolidColorBrush x:Key="AccentDim" Color="#332DE2E6"/>
    <SolidColorBrush x:Key="Magenta" Color="#FFFF3D8A"/>
    <SolidColorBrush x:Key="Good" Color="#FF3DDC97"/>
    <SolidColorBrush x:Key="Bad" Color="#FFFF5C7A"/>

    <FontFamily x:Key="UiFont">Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Consolas</FontFamily>

    <!-- section label in the rail -->
    <Style x:Key="RailSection" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextFaint}"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="22,18,0,8"/>
      <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
    </Style>

    <!-- nav item: the accent is a glowing edge bar, not a filled block -->
    <Style x:Key="NavItem" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
      <Setter Property="Margin" Value="10,1,10,1"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Grid>
              <Border x:Name="Fill" CornerRadius="8" Background="Transparent" Height="36"/>
              <Border x:Name="Edge" Width="2" HorizontalAlignment="Left" Height="18" CornerRadius="1"
                      Background="{StaticResource Accent}" Opacity="0" Margin="0,0,0,0">
                <Border.Effect><DropShadowEffect Color="#2DE2E6" BlurRadius="12" ShadowDepth="0" Opacity="0.9"/></Border.Effect>
              </Border>
              <ContentPresenter VerticalAlignment="Center" Margin="20,0,0,0"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Fill" Property="Background" Value="#14FFFFFF"/>
                <Setter TargetName="Edge" Property="Opacity" Value="1"/>
                <Setter Property="Foreground" Value="{StaticResource Text}"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Fill" Property="Background" Value="#0AFFFFFF"/>
                <Setter Property="Foreground" Value="{StaticResource Text}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- pill tab -->
    <Style x:Key="PillTab" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="B" CornerRadius="16" Padding="20,7" Background="Transparent" Margin="2,0">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="B" Property="Background" Value="{StaticResource CardRaised}"/>
                <Setter Property="Foreground" Value="{StaticResource Text}"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Text}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- filter chip -->
    <Style x:Key="Chip" TargetType="RadioButton" BasedOn="{StaticResource PillTab}">
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="B" CornerRadius="14" Padding="14,5" Background="Transparent"
                    BorderBrush="Transparent" BorderThickness="1" Margin="2,0">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="B" Property="Background" Value="{StaticResource AccentDim}"/>
                <Setter TargetName="B" Property="BorderBrush" Value="#552DE2E6"/>
                <Setter Property="Foreground" Value="{StaticResource Accent}"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="B" Property="Background" Value="#0AFFFFFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- primary button: neon outline, fills on hover -->
    <Style x:Key="GhostButton" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" CornerRadius="10" Padding="18,9" Background="{StaticResource CardRaised}"
                    BorderBrush="{StaticResource Stroke}" BorderThickness="1">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="B" Property="BorderBrush" Value="#662DE2E6"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
      <Setter Property="Foreground" Value="#FF04262A"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" CornerRadius="10" Padding="18,9">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                  <GradientStop Color="#FF2DE2E6" Offset="0"/>
                  <GradientStop Color="#FF19B9D8" Offset="1"/>
                </LinearGradientBrush>
              </Border.Background>
              <Border.Effect><DropShadowEffect Color="#2DE2E6" BlurRadius="18" ShadowDepth="0" Opacity="0.35"/></Border.Effect>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="B" Property="Effect">
                  <Setter.Value><DropShadowEffect Color="#2DE2E6" BlurRadius="26" ShadowDepth="0" Opacity="0.6"/></Setter.Value>
                </Setter>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- text field -->
    <Style x:Key="Field" TargetType="TextBox">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="CaretBrush" Value="{StaticResource Accent}"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="B" CornerRadius="10" Background="#FF0C1016"
                    BorderBrush="{StaticResource Stroke}" BorderThickness="1" Padding="14,10">
              <ScrollViewer x:Name="PART_ContentHost"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="B" Property="BorderBrush" Value="#992DE2E6"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>


    <!-- ============ wave layer ============
         Decorative contour lines, the way the reference does it. Each brush paints its own base fill
         first, so a wave background is a single Background="..." swap rather than an extra element in
         every card. Viewbox is pinned in absolute units so curves may overflow and get clipped instead
         of shifting the fill. Line colours sit 8-14 steps above the fill: visible as texture, never
         enough to compete with the text on top. -->

    <DrawingBrush x:Key="CardWave" Stretch="Fill" Viewbox="0,0,600,120" ViewboxUnits="Absolute">
      <DrawingBrush.Drawing>
        <DrawingGroup>
          <GeometryDrawing Brush="#FF10141B" Geometry="M0,0 H600 V120 H0 Z"/>
          <GeometryDrawing Geometry="M-40,112 C90,74 180,140 300,102 C400,70 480,120 660,84">
            <GeometryDrawing.Pen><Pen Brush="#FF212D3D" Thickness="1.4"/></GeometryDrawing.Pen>
          </GeometryDrawing>
          <GeometryDrawing Geometry="M-40,94 C90,56 180,122 300,84 C400,52 480,102 660,66">
            <GeometryDrawing.Pen><Pen Brush="#FF1E2937" Thickness="1.3"/></GeometryDrawing.Pen>
          </GeometryDrawing>
          <GeometryDrawing Geometry="M-40,76 C90,38 180,104 300,66 C400,34 480,84 660,48">
            <GeometryDrawing.Pen><Pen Brush="#FF1B2531" Thickness="1.2"/></GeometryDrawing.Pen>
          </GeometryDrawing>
          <GeometryDrawing Geometry="M-40,58 C90,20 180,86 300,48 C400,16 480,66 660,30">
            <GeometryDrawing.Pen><Pen Brush="#40233346" Thickness="1.2"/></GeometryDrawing.Pen>
          </GeometryDrawing>
          <GeometryDrawing Geometry="M-40,40 C90,2 180,68 300,30 C400,-2 480,48 660,12">
            <GeometryDrawing.Pen><Pen Brush="#33202E3E" Thickness="1.1"/></GeometryDrawing.Pen>
          </GeometryDrawing>
          <GeometryDrawing Geometry="M-40,22 C90,-16 180,50 300,12 C400,-20 480,30 660,-6">
            <GeometryDrawing.Pen><Pen Brush="#241C2836" Thickness="1"/></GeometryDrawing.Pen>
          </GeometryDrawing>
        </DrawingGroup>
      </DrawingBrush.Drawing>
    </DrawingBrush>

    <DrawingBrush x:Key="BgWave" Stretch="Fill" Viewbox="0,0,900,620" ViewboxUnits="Absolute">
      <DrawingBrush.Drawing>
        <DrawingGroup>
          <GeometryDrawing Brush="#FF07090D" Geometry="M0,0 H900 V620 H0 Z"/>
          <GeometryDrawing Geometry="M-60,92 C160,34 320,138 540,80 C700,36 810,100 960,58">
            <GeometryDrawing.Pen><Pen Brush="#FF141C27" Thickness="1.8"/></GeometryDrawing.Pen>
          </GeometryDrawing>
          <GeometryDrawing Geometry="M-60,68 C160,10 320,114 540,56 C700,12 810,76 960,34">
            <GeometryDrawing.Pen><Pen Brush="#FF111823" Thickness="1.6"/></GeometryDrawing.Pen>
          </GeometryDrawing>
          <GeometryDrawing Geometry="M-60,44 C160,-14 320,90 540,32 C700,-12 810,52 960,10">
            <GeometryDrawing.Pen><Pen Brush="#33172230" Thickness="1.4"/></GeometryDrawing.Pen>
          </GeometryDrawing>
          <GeometryDrawing Geometry="M-60,20 C160,-38 320,66 540,8 C700,-36 810,28 960,-14">
            <GeometryDrawing.Pen><Pen Brush="#1A2DE2E6" Thickness="1.2"/></GeometryDrawing.Pen>
          </GeometryDrawing>
        </DrawingGroup>
      </DrawingBrush.Drawing>
    </DrawingBrush>

    <DrawingBrush x:Key="RailWave" Stretch="Fill" Viewbox="0,0,220,700" ViewboxUnits="Absolute">
      <DrawingBrush.Drawing>
        <DrawingGroup>
          <GeometryDrawing Brush="#FF0A0D12" Geometry="M0,0 H220 V700 H0 Z"/>
          <GeometryDrawing Geometry="M-20,72 C50,36 110,96 170,60 C205,38 220,62 250,48">
            <GeometryDrawing.Pen><Pen Brush="#FF161F2B" Thickness="1.4"/></GeometryDrawing.Pen>
          </GeometryDrawing>
          <GeometryDrawing Geometry="M-20,50 C50,14 110,74 170,38 C205,16 220,40 250,26">
            <GeometryDrawing.Pen><Pen Brush="#FF131A24" Thickness="1.3"/></GeometryDrawing.Pen>
          </GeometryDrawing>
          <GeometryDrawing Geometry="M-20,28 C50,-8 110,52 170,16 C205,-6 220,18 250,4">
            <GeometryDrawing.Pen><Pen Brush="#2E18232F" Thickness="1.1"/></GeometryDrawing.Pen>
          </GeometryDrawing>
        </DrawingGroup>
      </DrawingBrush.Drawing>
    </DrawingBrush>

    <DrawingBrush x:Key="PanelWave" Stretch="Fill" Viewbox="0,0,340,470" ViewboxUnits="Absolute">
      <DrawingBrush.Drawing>
        <DrawingGroup>
          <GeometryDrawing Brush="#FF10141B" Geometry="M0,0 H340 V470 H0 Z"/>
          <GeometryDrawing Geometry="M-30,64 C70,28 140,90 230,56 C295,30 330,66 380,46">
            <GeometryDrawing.Pen><Pen Brush="#FF1D2735" Thickness="1.3"/></GeometryDrawing.Pen>
          </GeometryDrawing>
          <GeometryDrawing Geometry="M-30,44 C70,8 140,70 230,36 C295,10 330,46 380,26">
            <GeometryDrawing.Pen><Pen Brush="#FF19222E" Thickness="1.2"/></GeometryDrawing.Pen>
          </GeometryDrawing>
          <GeometryDrawing Geometry="M-30,24 C70,-12 140,50 230,16 C295,-10 330,26 380,6">
            <GeometryDrawing.Pen><Pen Brush="#33172230"/></GeometryDrawing.Pen>
          </GeometryDrawing>
        </DrawingGroup>
      </DrawingBrush.Drawing>
    </DrawingBrush>

  </Application.Resources>
</Application>
